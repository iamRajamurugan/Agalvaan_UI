/* ==========================================================================
   ROVER MISSION CONTROL — MASTER STYLESHEET (Dark Competition Palette)
   ========================================================================== */

/* Global Window & Base */
QMainWindow, QWidget#CentralWidget {
    background-color: #0f1218;
    color: #f1f5f9;
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Roboto", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

/* Header Container */
QWidget#HeaderBar {
    background-color: #161b24;
    border-bottom: 1px solid #232a38;
    padding: 8px 16px;
}

QLabel#AppTitle {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: #f8fafc;
}

QLabel#AppSubtitle {
    font-size: 11px;
    font-weight: 600;
    color: #38bdf8;
    letter-spacing: 0.8px;
}

/* Card / Panel Base */
QFrame.StatusCard {
    background-color: #171c26;
    border: 1px solid #232b3b;
    border-radius: 6px;
}

QFrame.StatusCard:hover {
    border-color: #334155;
}

QLabel#CardHeader {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.8px;
    color: #94a3b8;
    padding-bottom: 4px;
    border-bottom: 1px solid #1e2636;
}

QLabel#CardValue {
    font-size: 14px;
    font-weight: 600;
    color: #f1f5f9;
}

QLabel#CardSubtext {
    font-size: 11px;
    color: #64748b;
}

/* Badges & Indicators */
QLabel.Badge {
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QLabel.BadgeDisconnected {
    background-color: #2b171a;
    color: #f87171;
    border: 1px solid #7f1d1d;
}

QLabel.BadgeMock {
    background-color: #1e2638;
    color: #38bdf8;
    border: 1px solid #0369a1;
}

QLabel.BadgeConnected {
    background-color: #122822;
    color: #34d399;
    border: 1px solid #065f46;
}

QLabel.BadgeWarning {
    background-color: #2b2212;
    color: #fbbf24;
    border: 1px solid #78350f;
}

/* Push Buttons */
QPushButton {
    background-color: #1e2636;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #283348;
    border-color: #475569;
}

QPushButton:pressed {
    background-color: #161c28;
}

QPushButton:disabled {
    background-color: #131720;
    color: #475569;
    border-color: #1e2636;
}

/* Primary Action Button */
QPushButton#PrimaryButton {
    background-color: #0284c7;
    border-color: #0369a1;
    color: #ffffff;
}

QPushButton#PrimaryButton:hover {
    background-color: #0369a1;
}

/* Emergency Stop. [engaged="true"] is the latched state: the button then reads
   HOLD TO RESET and the safety badge reads E-STOP ACTIVE. */
QPushButton#EStopButton {
    background-color: #dc2626;
    border: 2px solid #fca5a5;
    border-radius: 4px;
    color: #ffffff;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 7px 12px;
}

QPushButton#EStopButton:hover {
    background-color: #b91c1c;
}

QPushButton#EStopButton:pressed {
    background-color: #991b1b;
}

QPushButton#EStopButton[engaged="true"] {
    background-color: #2b171a;
    border: 2px solid #dc2626;
    color: #fca5a5;
}

QPushButton#EStopButton[engaged="true"]:hover {
    background-color: #3a1c20;
}

/* Monospace Values for Timers and Diagnostics */
QLabel.MonoStat {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 16px;
    font-weight: 700;
    color: #38bdf8;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #0f1218;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #232b3b;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #334155;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ==========================================================================
   MISSION CLOCK, PHASE & DEV CONTROLS (Phase 3B)
   ========================================================================== */

/* Small captions above header controls (MISSION CLOCK, CONTROL MODE, SAFETY) */
QLabel#HeaderCaption {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #7c8ba1;
}

/* MISSION COMPLETE */
QLabel#HeaderCaption[severity="ERROR"] {
    color: #f87171;
    font-weight: 800;
}

QPushButton#MissionStartButton {
    background-color: #0284c7;
    border: 1px solid #0369a1;
    border-radius: 4px;
    padding: 8px 12px;
    min-width: 76px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.8px;
    color: #ffffff;
}

QPushButton#MissionStartButton:hover {
    background-color: #0369a1;
}

/* Disabled = the run is under way or over; the label says which */
QPushButton#MissionStartButton:disabled {
    background-color: #131720;
    border-color: #2b3448;
    color: #7c8ba1;
}

/* Deliberately the largest text in the window: readable at a glance */
QLabel#MissionClockValue {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 30px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #38bdf8;
    padding: 0px 6px;
}

QLabel#MissionClockValue[severity="WARNING"] { color: #fbbf24; }
QLabel#MissionClockValue[severity="ERROR"]   { color: #f87171; }

QLabel#MissionPhaseBadge {
    background-color: #10243a;
    color: #38bdf8;
    border: 1px solid #0369a1;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
}

QLabel#MissionPhaseBadge[severity="OFFLINE"] {
    background-color: #1b202b;
    color: #94a3b8;
    border-color: #334155;
}

QWidget#MissionBar {
    background-color: #12161f;
    border-bottom: 1px solid #232a38;
}

QLabel#MissionBarLabel {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #7c8ba1;
    padding-right: 4px;
}

QPushButton#PhaseButton {
    background-color: #171d29;
    border: 1px solid #2b3448;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    color: #94a3b8;
}

QPushButton#PhaseButton:hover {
    border-color: #475569;
    color: #e2e8f0;
}

QPushButton#PhaseButton:checked {
    background-color: #10243a;
    border-color: #0ea5e9;
    color: #38bdf8;
}

QPushButton#ClockButton {
    background-color: #1e2636;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 700;
    color: #cbd5e1;
}

QPushButton#ClockButton:hover {
    background-color: #283348;
    color: #ffffff;
}

QLabel#MockControlsHint {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    color: #4b5772;
    padding-left: 10px;
}

/* ==========================================================================
   TELEMETRY PANEL (Phase 3A)
   Severity is expressed through the dynamic property [severity="..."], set in
   Python via ui.components.telemetry_primitives.apply_severity(). Severity is
   always accompanied by explicit text, never signalled by colour alone.
   ========================================================================== */

QWidget#TelemetryPanel {
    background-color: transparent;
}

QFrame#TelemetryCard {
    background-color: #141924;
    border: 1px solid #232b3b;
    border-radius: 6px;
}

QFrame#TelemetryCard:hover {
    border-color: #334155;
}

QLabel#TelemetryCardTitle {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #7c8ba1;
    padding-bottom: 4px;
    border-bottom: 1px solid #1e2636;
}

QLabel#MetricLabel {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
    color: #708096;
}

/* Numeric readings: neutral when nominal, coloured only when off-nominal */
QLabel#MetricValue {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    font-weight: 700;
    color: #e2e8f0;
}

QLabel#MetricValue[severity="WARNING"] { color: #fbbf24; }
QLabel#MetricValue[severity="ERROR"]   { color: #f87171; }
QLabel#MetricValue[severity="OFFLINE"] { color: #64748b; }
QLabel#MetricValue[severity="NO_DATA"] { color: #475569; }

/* Headline readings (battery %, speed, roll/pitch, link state) */
QLabel#MetricValueStrong {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 14px;
    font-weight: 800;
    color: #38bdf8;
}

QLabel#MetricValueStrong[severity="WARNING"] { color: #fbbf24; }
QLabel#MetricValueStrong[severity="ERROR"]   { color: #f87171; }
QLabel#MetricValueStrong[severity="OFFLINE"] { color: #64748b; }
QLabel#MetricValueStrong[severity="NO_DATA"] { color: #475569; }

/* State words (HEALTHY / LOW / ONLINE / OFFLINE): coloured by condition */
QLabel#StatusValue {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.6px;
    color: #94a3b8;
}

QLabel#StatusValue[severity="NORMAL"]  { color: #34d399; }
QLabel#StatusValue[severity="WARNING"] { color: #fbbf24; }
QLabel#StatusValue[severity="ERROR"]   { color: #f87171; }
QLabel#StatusValue[severity="OFFLINE"] { color: #64748b; }
QLabel#StatusValue[severity="NO_DATA"] { color: #475569; }

/* Compact diagnostics footer inside the sensors card */
QLabel#CardSubtext[severity="NO_DATA"] { color: #475569; }
QLabel#CardSubtext[severity="WARNING"] { color: #fbbf24; }
QLabel#CardSubtext[severity="ERROR"]   { color: #f87171; }

/* ==========================================================================
   OPERATOR LAYOUT (header controls, camera HUD, terminal)
   ========================================================================== */

QLabel#SafetyBadge {
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    background-color: #122822;
    color: #34d399;
    border: 1px solid #065f46;
}

QLabel#SafetyBadge[severity="ERROR"] {
    background-color: #dc2626;
    color: #ffffff;
    border: 1px solid #ef4444;
}

/* MANUAL / AUTONOMOUS selector */
QPushButton#ModeButton {
    background-color: #171d29;
    border: 1px solid #2b3448;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.8px;
    color: #94a3b8;
}

QPushButton#ModeButton:hover {
    border-color: #475569;
    color: #e2e8f0;
}

QPushButton#ModeButton:checked {
    background-color: #0284c7;
    border-color: #38bdf8;
    color: #ffffff;
}

QPushButton#ModeButton:disabled {
    background-color: #131720;
    border-color: #1e2636;
    color: #475569;
}

/* Small segmented selector (FRONT / REAR camera) */
QPushButton#SegmentButton {
    background-color: #171d29;
    border: 1px solid #2b3448;
    border-radius: 3px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    color: #94a3b8;
}

QPushButton#SegmentButton:hover {
    border-color: #475569;
    color: #e2e8f0;
}

QPushButton#SegmentButton:checked {
    background-color: #10243a;
    border-color: #0ea5e9;
    color: #38bdf8;
}

/* Marker detection status in the camera HUD */
QLabel#MarkerStatus {
    padding: 2px 8px;
    border-radius: 3px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    background-color: #1b202b;
    color: #94a3b8;
    border: 1px solid #334155;
}

QLabel#MarkerStatus[severity="NORMAL"] {
    background-color: #122822;
    color: #34d399;
    border-color: #065f46;
}

QLabel#MarkerStatus[severity="NO_DATA"] { color: #475569; }

/* Which source is feeding the camera view (amber when it is a stand-in) */
QLabel#VideoSourceLabel {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #708096;
}

QLabel#VideoSourceLabel[severity="WARNING"] { color: #fbbf24; }

/* Collapsible terminal */
QFrame#LogConsole {
    background-color: #0c0f15;
    border-top: 1px solid #232a38;
}

QPushButton#LogToggleButton {
    background-color: transparent;
    border: none;
    padding: 2px 4px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #7c8ba1;
}

QPushButton#LogToggleButton:hover { color: #e2e8f0; }

QLabel#LogLastMessage {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
    color: #708096;
}

QLabel#LogLastMessage[severity="WARNING"] { color: #fbbf24; }
QLabel#LogLastMessage[severity="ERROR"]   { color: #f87171; }

QPlainTextEdit#LogView {
    background-color: #0a0d13;
    border: none;
    border-top: 1px solid #1e2636;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
    color: #cbd5e1;
}

/* ==========================================================================
   NAVIGATION STATE BANNER & ENVIRONMENT CARD
   ========================================================================== */

QFrame#NavStateBanner {
    background-color: #10243a;
    border: 1px solid #0369a1;
    border-radius: 4px;
}

QFrame#NavStateBanner[severity="WARNING"] {
    background-color: #2b2212;
    border-color: #b45309;
}

QFrame#NavStateBanner[severity="OFFLINE"],
QFrame#NavStateBanner[severity="NO_DATA"] {
    background-color: #1b202b;
    border-color: #334155;
}

QLabel#NavStateIcon, QLabel#NavStateValue {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.8px;
    color: #38bdf8;
    background-color: transparent;
}

QLabel#NavStateIcon[severity="WARNING"], QLabel#NavStateValue[severity="WARNING"] { color: #fbbf24; }
QLabel#NavStateIcon[severity="OFFLINE"], QLabel#NavStateValue[severity="OFFLINE"] { color: #94a3b8; }
QLabel#NavStateIcon[severity="NO_DATA"], QLabel#NavStateValue[severity="NO_DATA"] { color: #475569; }

/* A card reporting an obstacle is outlined in amber (its text also says so) */
QFrame#TelemetryCard[severity="WARNING"] {
    border-color: #b45309;
}

/* ==========================================================================
   CAMERA PLAYER HUD
   ========================================================================== */

QWidget#VideoTopHUD {
    background-color: #0e121a;
    border-bottom: 1px solid #232a38;
}

QWidget#VideoBottomHUD {
    background-color: #0e121a;
    border-top: 1px solid #232a38;
}

QLabel#LiveBadge {
    background-color: #dc2626;
    color: #ffffff;
    border: 1px solid #ef4444;
    border-radius: 3px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

/* Stream state while not live: CONNECTING / RECONNECTING / OFFLINE / ... */
QLabel#StreamStateBadge {
    background-color: #1b202b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 3px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

QLabel#StreamStateBadge[severity="WARNING"] {
    background-color: #2b2212;
    color: #fbbf24;
    border-color: #78350f;
}

QLabel#StreamStateBadge[severity="ERROR"] {
    background-color: #2b171a;
    color: #f87171;
    border-color: #7f1d1d;
}

QLabel#VideoResolution {
    background-color: #1e2638;
    color: #38bdf8;
    border: 1px solid #0369a1;
    border-radius: 3px;
    padding: 2px 8px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
    font-weight: 700;
}

QLabel#VideoTitle {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #e2e8f0;
}

QLabel#VideoStat {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    font-weight: 700;
    color: #38bdf8;
}

QPushButton#StreamButton, QPushButton#HudButton {
    border-radius: 3px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
}

QPushButton#StreamButton {
    background-color: #0284c7;
    border: 1px solid #0369a1;
    color: #ffffff;
}

QPushButton#StreamButton:hover {
    background-color: #0369a1;
}

QPushButton#StreamButton[active="true"] {
    background-color: #991b1b;
    border-color: #b91c1c;
}

QPushButton#StreamButton[active="true"]:hover {
    background-color: #7f1d1d;
}

QPushButton#StreamButton:disabled {
    background-color: #131720;
    border-color: #1e2636;
    color: #475569;
}
